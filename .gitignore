# Environment
.env
.env.local

# Release gate runtime state (Session S6) — API rewrites; must not dirty git-bridge
config/release_gate_state.json
config/release_gate_state_*.json
config/release_gate_state_history.json
config/release_gate.log

# Drift proposal runtime JSON (created by nightly agent / API)
agent/drift-proposals/*.json

# Agent remediation job archives (full task log + summary)
agent/remediation-jobs/*.json

# Python
__pycache__/
*.pyc

# Go
api/bin/
api/platform-api
# 历史误提交的根级构建产物路径（63MB 二进制），正确路径是上面的 api/bin/
/bin/
*.exe
*.test

# Node
# 依赖树一律不入库（六处历史遗留已于本次 git rm --cached 清理；
# 部署走 deploy_mac_mini.sh 的 --exclude=node_modules + 远程 npm install，package-lock 保证可复现）
node_modules/
console/dist/
console/.vite/
console/tsconfig.tsbuildinfo

# Dev Agent runtime state (phase status, jobs, history)
data/dev-agent/
data/programs/
data/sessions/
data/briefing/
data/patrol/
# Checklist + Operate Queue stores — API rewrites on every run; must not dirty git-bridge
data/checklist/
data/operate/

# OS / IDE
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
.docker-build/

# Escape hatch drill state
data/escape_hatch/

# Release cycle + gate runtime (API rewrites; must not dirty git-bridge)
data/release_cycles_*.json
data/release_gate_state*.json
data/release_gate_state_*.json
data/release_gate.log

