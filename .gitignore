# Environment
.env
.env.local

# Release gate runtime state (Session S6)
config/release_gate_state.json
config/release_gate.log

# Drift proposal runtime JSON (created by nightly agent / API)
agent/drift-proposals/*.json

# Agent remediation job archives (full task log + summary)
agent/remediation-jobs/*.json

# Python
__pycache__/
*.pyc

# Go
api/bin/
api/platform-api
*.exe
*.test

# Node
console/node_modules/
console/dist/
console/.vite/
console/tsconfig.tsbuildinfo

# Dev Agent runtime state (phase status, jobs, history)
data/dev-agent/
data/programs/
data/sessions/
data/briefing/
data/patrol/
# Checklist + Operate Queue stores — API rewrites on every run; must not dirty git-bridge
data/checklist/
data/operate/

# OS / IDE
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
.docker-build/

# Release cycle runtime (API rewrites; must not dirty git-bridge)
data/release_cycles_*.json
