    ],
    "image": "alpine/git:2.45.2",
    "name": "clone",
    "script": "#!/usr/bin/env sh\nset -eu\nuser=\"${GIT_USERNAME:?}\"\npassword=\"${GIT_PASSWORD:?}\"\nunset GIT_USERNAME GIT_PASSWORD\nauth=\"$(printf '%s:%s' \"$user\" \"$password\" | base64 | tr -d '\\n')\"\nunset user password\ngit_read() {\n  GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0 \\\n  GIT_CONFIG_COUNT=3 \\\n  GIT_CONFIG_KEY_0=http.http://gitea.cicd.svc.cluster.local:3000/.extraHeader \\\n  GIT_CONFIG_VALUE_0=\"Authorization: Basic $auth\" \\\n  GIT_CONFIG_KEY_1=http.followRedirects GIT_CONFIG_VALUE_1=false \\\n  GIT_CONFIG_KEY_2=credential.helper GIT_CONFIG_VALUE_2= git \"$@\"\n}\nurl=\"${CLONE_URL}\"\ncase \"$url\" in *[!A-Za-z0-9._:/-]*) echo \"invalid Gitea URL\" >&2; exit 1 ;; esac\nrev=\"${REVISION}\"\nsubdir=\"${SUBDIR}\"\nprintf '%s' \"$url\" | grep -Eq '^http://gitea\\.cicd\\.svc\\.cluster\\.local:3000/[A-Za-z0-9_-]+/[A-Za-z0-9_-][A-Za-z0-9._-]*\\.git$' || { echo \"invalid Gitea URL\" >&2; exit 1; }\ncase \"$subdir\" in\n  *[!A-Za-z0-9._-]*|.*|-*) echo \"invalid subdir\" >&2; exit 1 ;;\nesac\ncase \"$rev\" in\n  ''|*[!A-Za-z0-9._/-]*|[!A-Za-z0-9]*) echo \"invalid revision\" >&2; exit 1 ;;\nesac\nif printf '%s' \"$rev\" | grep -Eq '^[0-9a-f]+$'; then\n  [ \"${#rev}\" -eq 40 ] || { echo \"SHA must have 40 hex characters\" >&2; exit 1; }\nelse\n  git check-ref-format \"refs/heads/$rev\" >/dev/null || { echo \"invalid ref\" >&2; exit 1; }\nfi\nout=\"$(workspaces.output.path)\"\ntarget=\"${out}${subdir:+/$subdir}\"\nmkdir -p \"$target\"\nrm -rf \"${target}\"/* \"${target}\"/.[!.]* \"${target}\"/..?*\necho \"Cloning ${url} @ ${rev} into ${target} ...\"\n# A push webhook hands us a commit SHA, and `git_read clone --branch` cannot\n# take one \u2014 it resolves branch and tag names only, so every\n# webhook-triggered run died here with \"Remote branch <sha> not found\".\n# Fetch the object instead; fall back to a full clone and checkout when\n# the server will not serve a bare SHA.\nif echo \"${rev}\" | grep -qE '^[0-9a-f]{40}$'; then\n  git init -q \"${target}\"\n  cd \"${target}\"\n  git remote add origin \"${url}\"\n  if git_read fetch -q --depth=1 origin \"${rev}\" 2>/dev/null; then\n    git checkout -q --detach FETCH_HEAD\n  else\n    echo \"server refused a bare-SHA fetch \u2014 cloning in full and checking out ${rev}\"\n    cd /\n    rm -rf \"${target}\"\n    git_read clone -q \"${url}\" \"${target}\"\n    cd \"${target}\"\n    git checkout -q --detach \"${rev}\"\n  fi\nelse\n  git_read clone --depth=1 --branch \"${rev}\" \"${url}\" \"${target}\"\n  cd \"${target}\"\nfi\nunset auth\nhead_sha=\"$(git rev-parse HEAD)\"\necho \"=== HEAD ${head_sha} ===\"\nprintf '%s' \"${head_sha}\" > \"$(results.commit.path)\"\ngit log -1 --oneline\nls -la\n"
   }
  ],
  "workspaces": [
   {
    "name": "output"
   }
  ]
 },
