for f in __init__.py agent-config/__init__.py agent-config/scripts/__init__.py k8s/__init__.py k8s/data/__init__.py scripts/__init__.py; do if [ -e "$f" ] || [ -L "$f" ]; then echo "$f: the infra check runs no test inside a Python package (its __init__.py can load a pytest plugin)" >&2; exit 3; fi; done; f=$(find -L k8s/data/role-matrix scripts/agentrt scripts/benchmark scripts/k3s -name __init__.py -print 2>/dev/null | head -n 1); if [ -n "$f" ]; then echo "$f: the infra check runs no test inside a Python package (its __init__.py can load a pytest plugin)" >&2; exit 3; fi; PATH="$PWD/.git/venv/bin:$PATH" GOCACHE="${TMPDIR:-$HOME/.cache}/go-build" PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 exec python3 -I -m pytest -c /dev/null --rootdir="$PWD" --noconftest -q -p no:cacheprovider agent-config/scripts/test_check_hardcoded_paths.py k8s/data/role-matrix scripts/agentrt scripts/benchmark scripts/k3s scripts/test_access_checks.py scripts/test_check_monitoring_persistence.py scripts/test_check_registry_images.py scripts/test_iv_depth_plan.py scripts/test_iv_empty_audit.py scripts/test_iv_repair_actions.py scripts/test_precommit_monitoring_checks.py scripts/test_research_alert_delivery_route.py scripts/test_research_secret_holders.py scripts/test_scrub_config_secrets.py