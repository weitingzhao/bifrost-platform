# Optional Ops API tokens for capabilities probe (L0 auth check).
# Copy from bifrost-trade-infra/config/config.dev.yaml ops.auth.tokens
BIFROST_DEV_OPS_TOKEN=
BIFROST_PROD_OPS_TOKEN=

# Platform API listen address (default :8780 = all interfaces)
# PLATFORM_LISTEN=:8780

# Console Vite bind (default 127.0.0.1). Use 0.0.0.0 so other Bifrost LAN Macs can open:
#   http://<this-Mac-192.168.10.x>:5180
PLATFORM_CONSOLE_HOST=0.0.0.0
# PLATFORM_CONSOLE_PORT=5180

# Daily Ops Fleet Desk viewer seat.
# Priority: OPS_VIEWER_ENV > (in-cluster only) clusters.yaml viewer_env > dev.
# Local make start: defaults to DEV (ignores yaml prod pin). Explicit override:
OPS_VIEWER_ENV=dev
# Prod in-cluster: clusters.yaml DefaultCluster viewer_env: prod (or set OPS_VIEWER_ENV=prod).
# OPS_VIEWER_ENV=prod

# Bifrost Trade Monitoring peer links (Ops Console sidebar footer).
# Defaults (no override): Traefik LAN ingress HTTPS —
#   DEV  https://dev.trader.bifrost.lan/
#   STG  https://stg.trader.bifrost.lan/
#   PROD https://trader.bifrost.lan/
# Optional per-env overrides (Dev / Stg / Prod chips; preferred chip follows Viewer env):
# VITE_TRADE_FRONTEND_URL_DEV=https://dev.trader.bifrost.lan/
# VITE_TRADE_FRONTEND_URL_STG=https://stg.trader.bifrost.lan/
# VITE_TRADE_FRONTEND_URL_PROD=https://trader.bifrost.lan/
# Local Vite compose example: VITE_TRADE_FRONTEND_URL_DEV=http://127.0.0.1:5173


# Platform L1 actuation auth (operator can restart/scale/delete cluster workloads)
PLATFORM_OPERATOR_TOKEN=
VITE_PLATFORM_OPERATOR_TOKEN=

# Admin token for cluster add-ons (metrics-server ensure)
PLATFORM_ADMIN_TOKEN=

# Layer A metrics-server install via platform-api (exec install-metrics-server.sh)
PLATFORM_METRICS_SERVER_ENABLED=1
# PLATFORM_METRICS_SERVER_SCRIPT=

# Layer B kube-prometheus-stack install via platform-api (default off until enabled)
PLATFORM_OBSERVABILITY_INSTALL_ENABLED=0
# PLATFORM_OBSERVABILITY_INSTALL_SCRIPT=

# Layer B observability deep links (optional; override clusters.yaml observability_urls)
# PLATFORM_GRAFANA_URL=http://192.168.10.73:30883
# PLATFORM_PROMETHEUS_URL=

# Path to environments config (default ./config/environments.yaml)
# PLATFORM_CONFIG=./config/environments.yaml

# UniFi UCG Max + USW (Agent network actuation — scripts/unifi_*.py)
# Session auth: port/VLAN/DHCP audit + legacy API reads
UNIFI_HOST=192.168.1.1
UNIFI_USER=
UNIFI_PASS=
# Integration API (optional — UCG Max 10.4 may omit site id; session auth is primary)
# Create: Network → Integrations (plug icon) → Create New API Key
UNIFI_API_KEY=
# Primary actuation: bifrost-agent local Super Admin (UNIFI_USER / UNIFI_PASS)
# Optional; default site on single-site controller
# UNIFI_SITE_UUID=6a4656e1345ed96057ff78a6

# Kubernetes cluster probe (L0) — local kubeconfig for platform-api
PLATFORM_KUBECONFIG=~/.kube/bifrost-k3s.yaml

# Market Data plugin Gallery probe (GET /api/v1/plugins/market-data/status).
# Default health URLs use *.svc.cluster.local; local Mac platform-api falls back to
# K8s API service proxy (no port-forward). Override only if you need plain HTTP:
# MARKET_DATA_STOCKS_HEALTH_URL=http://127.0.0.1:18080/health
# MARKET_DATA_OPTIONS_HEALTH_URL=http://127.0.0.1:18081/health
# Freshness SQL target DB — Golden Source (data_ops.ingest_freshness).
# Trade DBs no longer have data_ops after write-consolidation DROP.
# MARKET_DATA_FRESHNESS_DB=bifrost_golden_source
# Plugin API proxy for Console Market Data manage page (optional local override):
# MARKET_DATA_API_URL=http://127.0.0.1:8790
# Default (unset): platform-api proxies via K8s service market-data-api:8790
# Console path: /api/v1/plugins/market-data/api/market/* → Plugin /market/*
# GET is unauthenticated; POST enqueue requires PLATFORM_OPERATOR_TOKEN (operator-authed).
# platform-api then attaches MARKET_DATA_WRITE_TOKEN toward Plugin as Bearer plus
# X-Market-Data-Write-Token (Kubernetes API proxy overwrites Authorization).
# Copy write-token from plugin-market-data secret; do not put it in the Console:
# MARKET_DATA_WRITE_TOKEN=

# IB Flex Query plugin (GET /api/v1/plugins/flex-query/status).
# Default API URL uses in-cluster service; local Mac platform-api falls back to
# K8s API service proxy. Override only if you need plain HTTP:
# FLEX_QUERY_API_URL=http://127.0.0.1:8791
# FLEX_QUERY_HEALTH_URL=http://127.0.0.1:18082/health
# FLEX_QUERY_FRESHNESS_DB=bifrost_golden_source
# Copy write-token from plugin-flex-query secret; do not put it in the Console:
# FLEX_QUERY_WRITE_TOKEN=

# IB Gateway Plugin — redis-ib ACL user platform (copy from bifrost-platform-plugin/.env)
REDIS_IB_PLATFORM_PASS=

# IB Gateway self-heal ladder (L1 auto rollout — D10 observe only; no place_order)
# OPS_IB_AUTOREPAIR_ENABLED=true
# OPS_IB_AUTO_ROLLOUT_COOLDOWN_SEC=900
# OPS_IB_SNAPSHOT_STALE_SEC=90
# OPS_IB_SNAPSHOT_STALE_MAX_BEFORE_ROLLOUT=3

# Sync kubeconfig from K3s server (sibling repo bifrost-trade-infra)
PLATFORM_CLUSTER_SYNC_ENABLED=1
# Absolute path recommended; run_platform.py also auto-resolves sibling infra/scripts/k3s/fetch-kubeconfig.sh
PLATFORM_CLUSTER_SYNC_SCRIPT=

# AI Auto-Remediation sidecar (Cursor SDK runner on :8781)
# CURSOR_API_KEY=
# REMEDIATION_RUNNER_URL=http://127.0.0.1:8781
# REMEDIATION_RUNNER_AUTOSTART=1  # make start auto-starts local runner when URL is localhost
# REMEDIATION_RUNNER_PORT=8781
# REMEDIATION_RUNNER_BIND=127.0.0.1
#   On Mac Mini agent host use 0.0.0.0 so Mac Pro platform-api can reach runner:
#   REMEDIATION_RUNNER_BIND=0.0.0.0
#   Mac Pro .env: REMEDIATION_RUNNER_URL=http://192.168.10.50:8781
# Agent Desk → Update agent on Mini (runs deploy_mac_mini.sh from platform-api host):
# AGENT_DEPLOY_ENABLED=1
# AGENT_DEPLOY_REMOTE=vision@192.168.10.50
# Do not put inline comments on the same line as AGENT_DEPLOY_REMOTE (use a separate # line).
# Console cannot type SSH passwords — deploy uses BatchMode publickey only.
# AGENT_DEPLOY_SSH_IDENTITY=~/.ssh/id_ed25519
# If omitted, script tries id_ed25519 → id_rsa → bifrost_deploy.
# Patrol (embedded in platform-api)
# PATROL_DISPATCH=stub          # CI/dry-run (no outbound)
# PATROL_DISPATCH=live          # default if unset: L0 local probe + L1+ Cursor Cloud
# PATROL_DISPATCH=local         # all skills via platform-api GET probes (no Cursor)
# PATROL_DISPATCH=cursor        # force Cursor Cloud for every skill (LAN MCP usually unreachable)
# PATROL_SKILLS_DIR=            # default: <platform>/config/patrol-skills
# PATROL_STATE_DIR=             # default: $PLATFORM_DATA_DIR/patrol or ~/.bifrost-dev/patrol
# CURSOR_AGENT_API_BASE=https://api.cursor.com
# PATROL_CURSOR_MODEL=          # optional model id for POST /v1/agents
# PATROL_CURSOR_REPO=           # optional GitHub repo URL (omit for no-repo agent)
# PATROL_CURSOR_REF=main
# CURSOR_API_KEY still required for live dispatch (same key as remediation runner)

# Hermes Gateway (self-built scheduler, runs on agent host :8782 — will be retired)
# HERMES_GATEWAY_URL=http://192.168.10.50:8782
# Legacy MCP probe (deprecated, use HERMES_GATEWAY_URL instead):
# HERMES_MCP_URL=http://192.168.10.50:8642/mcp
# Nous Research Hermes Agent (real AI agent, dashboard on agent host :9119)
# NOUS_HERMES_URL=http://192.168.10.50:9119
# NOUS_HERMES_USER=bifrost
# NOUS_HERMES_PASS=
# REMEDIATION_CWD=../bifrost-trade-infra
# REMEDIATION_MODEL=composer-2.5
# NIGHTLY_SKIP_CLUSTER=0
# Git Bridge — dev Mac Pro LAN URL (Release Agent on Mini calls this; NOT in K8s)
# GIT_BRIDGE_URL=http://192.168.10.40:8785
# Satellite probe bridge — Mac thin-client probe of K3s dev for dev-local bus-deep
# SATELLITE_PROBE_BRIDGE_URL=http://127.0.0.1:8786
# PLATFORM_API_URL=http://127.0.0.1:8780
# Mini agent host env.sh: PLATFORM_API_URL=http://192.168.10.73:30878 (or Mac Pro LAN :8780)
